  </resheader>


<data name="AttachmentList_Name" xml:space="preserve">
    <value>Attachment List</value>
  </data>
  <data name="AttachmentList_Desc" xml:space="preserve">
    <value>The notes and attachments on a record, with download.</value>
  </data>

  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Notes</value>
  </data>

  <data name="fileNameColumn_Name" xml:space="preserve">
    <value>File name</value>
  </data>
  <data name="fileNameColumn_Desc" xml:space="preserve">
    <value>The column holding the file name — filename on the Note table.</value>
  </data>
  <data name="fileSizeColumn_Name" xml:space="preserve">
    <value>File size</value>
  </data>
  <data name="fileSizeColumn_Desc" xml:space="preserve">
    <value>The column holding the size in bytes — filesize. Without it, no size is shown.</value>
  </data>
  <data name="mimeTypeColumn_Name" xml:space="preserve">
    <value>File type</value>
  </data>
  <data name="mimeTypeColumn_Desc" xml:space="preserve">
    <value>The column holding the MIME type — mimetype. Without it, downloads are saved as a generic file.</value>
  </data>
  <data name="isDocumentColumn_Name" xml:space="preserve">
    <value>Is a file</value>
  </data>
  <data name="isDocumentColumn_Desc" xml:space="preserve">
    <value>The column that tells a file from a text note — isdocument. Without it, a row with a file name is treated as a file.</value>
  </data>
  <data name="subjectColumn_Name" xml:space="preserve">
    <value>Title</value>
  </data>
  <data name="subjectColumn_Desc" xml:space="preserve">
    <value>The column holding the title — subject. Without it, the file name is the title.</value>
  </data>
  <data name="createdOnColumn_Name" xml:space="preserve">
    <value>Created on</value>
  </data>
  <data name="createdOnColumn_Desc" xml:space="preserve">
    <value>The column holding the creation date — createdon. Without it, no date is shown.</value>
  </data>

  <data name="bodyColumn_Name" xml:space="preserve">
    <value>Body column</value>
  </data>
  <data name="bodyColumn_Desc" xml:space="preserve">
    <value>The logical name of the column holding the file itself. Fetched only when a file is downloaded.</value>
  </data>
  <data name="hideTextNotes_Name" xml:space="preserve">
    <value>Hide text notes</value>
  </data>
  <data name="hideTextNotes_Desc" xml:space="preserve">
    <value>Show only rows that carry a file.</value>
  </data>
  <data name="maxDownloadSizeMb_Name" xml:space="preserve">
    <value>Maximum download (MB)</value>
  </data>
  <data name="maxDownloadSizeMb_Desc" xml:space="preserve">
    <value>Files larger than this are refused before they are fetched.</value>
  </data>
  <data name="pageSize_Name" xml:space="preserve">
    <value>Page size</value>
  </data>
  <data name="pageSize_Desc" xml:space="preserve">
    <value>How many rows to request per page. The platform may clamp large values.</value>
  </data>
  <data name="downloadedRecordId_Name" xml:space="preserve">
    <value>Downloaded note ID</value>
  </data>
  <data name="downloadedRecordId_Desc" xml:space="preserve">
    <value>The ID of the row whose download was last requested. Use this to download the file yourself in a canvas app.</value>
  </data>

  <data name="AttachmentList_Loading" xml:space="preserve">
    <value>Loading notes…</value>
  </data>
  <data name="AttachmentList_Empty" xml:space="preserve">
    <value>No notes on this record.</value>
  </data>
  <data name="AttachmentList_NoFiles" xml:space="preserve">
    <value>No attachments on this record.</value>
  </data>
  <data name="AttachmentList_Error" xml:space="preserve">
    <value>These notes could not be loaded.</value>
  </data>
  <data name="AttachmentList_NoFileNameColumn" xml:space="preserve">
    <value>Map a column to File name to list the attachments.</value>
  </data>
  <data name="AttachmentList_ListLabel" xml:space="preserve">
